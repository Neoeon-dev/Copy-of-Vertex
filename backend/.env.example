# MailTrace Backend Configuration
# Copy this file to .env and update values as needed.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql+psycopg2://mailtrace:mailtrace@localhost:5432/mailtrace

# Demo mode: replace external intelligence lookups with deterministic fixtures
# Set to 'true' for development without external DNS/GeoIP services
DEMO_MODE=true

# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=10

# GeoIP database directory (optional, for IP geolocation)
# GEOIP_DB_DIR=/usr/share/GeoIP

# ── Supabase (for deployment) ──────────────────────────────
# Uncomment and fill when deploying to Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
